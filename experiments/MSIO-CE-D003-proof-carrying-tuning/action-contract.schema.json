{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelstateio.local/schemas/action-contract-v0.json",
  "title": "ModelStateIO proof-carrying action contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "runtime_identity",
    "model_state_identity",
    "objective",
    "requested_action",
    "semantic_intent",
    "receipt_requirements",
    "rollback",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "modelstateio-action-contract-v0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "runtime_identity": {
      "type": "object",
      "required": ["source_revision", "binary_sha256", "help_sha256"],
      "properties": {
        "source_revision": {"type": "string", "minLength": 7},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model_state_identity": {
      "type": "object",
      "required": ["state_id", "sha256", "bytes"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "objective": {
      "type": "object",
      "required": ["metric", "direction", "guardrails"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "direction": {"enum": ["minimize", "maximize"]},
        "guardrails": {"type": "object"}
      }
    },
    "requested_action": {
      "type": "object",
      "required": ["action_family", "parameters"],
      "properties": {
        "action_family": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "semantic_intent": {
      "type": "object",
      "required": ["intent_id", "predicates"],
      "properties": {
        "intent_id": {"type": "string", "minLength": 1},
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "op", "value"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "op": {"enum": ["eq", "ge", "le", "contains"]},
              "value": {},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "receipt_requirements": {
      "type": "object",
      "required": ["channels", "freshness_required", "identity_match_required"],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["control_plane", "physical", "semantic", "lineage"]}
        },
        "freshness_required": {"const": true},
        "identity_match_required": {"const": true}
      }
    },
    "rollback": {
      "type": "object",
      "required": ["required", "predicate"],
      "properties": {
        "required": {"type": "boolean"},
        "predicate": {"type": ["object", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["proposer", "requested_model", "prompt_sha256", "created_at"],
      "properties": {
        "proposer": {"enum": ["llm", "deterministic"]},
        "requested_model": {"type": ["string", "null"]},
        "prompt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
